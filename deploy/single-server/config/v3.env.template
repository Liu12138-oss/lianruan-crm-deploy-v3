APP_ENV=production
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=/app/logs
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=10
LOG_COMPRESS_ROTATED=true
API_HOST=0.0.0.0
API_PORT=3100
REQUEST_BODY_LIMIT=10mb
TRUSTED_PROXY_IPS=127.0.0.1,::1
CORS_ORIGIN=http://__SERVER_HOST__
SESSION_SECRET=__SESSION_SECRET__
DATABASE_URL=postgres://lianruan_app:__POSTGRES_PASSWORD__@postgres:5432/lianruan_crm_v3
REDIS_URL=redis://:__REDIS_PASSWORD__@redis-state:6379/0
HEALTH_DEPENDENCY_MODE=real
WORKER_ENABLED=true
WORKER_HEALTH_QUEUE=v3-health
# 组织架构默认完全关闭；新版本先在三个开关均关闭时完成迁移和发布验证，再单独开启总开关进入只读观察。
V3_ORGANIZATION_ENABLED=false
V3_ORGANIZATION_WRITE_ENABLED=false
# 渠道成员手机号可能参与 IAM/UniSDP 身份匹配，专项回归前保持只读。
V3_ORGANIZATION_CHANNEL_PHONE_EDIT_ENABLED=false
# 账号状态防护与交接执行分离；开启交接前必须先开启状态防护，回退交接时不得关闭状态防护。
V3_AUTH_ACCOUNT_STATUS_CHECK_ENABLED=false
# 账号停用归档与交接执行独立开关；开启前必须确认主任务进程正常并完成专项验收。
V3_ORGANIZATION_OFFBOARDING_ENABLED=false
V3_ORGANIZATION_OFFBOARDING_POLL_INTERVAL_MS=5000
# 仅控制管理端导航；开启后“组织架构”显示为“组织与账号”，旧账号和企业管理员菜单隐藏，但旧路由继续保留。
V3_ORGANIZATION_ACCOUNT_ENTRY_MERGED=false
# 企业微信组织同步与组织写入开关分离。同步首期仅生成差异预览，不自动改写账号、角色、渠道或业务归属。
V3_DIRECTORY_SYNC_ENABLED=false
# 统一消息提醒平台默认关闭；完成迁移、种子数据、权限和自检后才显式开启。
MESSAGE_WORKER_ENABLED=false
# 渠道产品订单预审独立任务默认关闭。泛微凭据仅填写在受控部署环境，禁止提交到仓库。
ORDER_PREAPPROVAL_WORKER_ENABLED=false
# ORDER_PREAPPROVAL_EVENT_CUTOVER_AT=2026-08-27T10:00:00+08:00
ORDER_PREAPPROVAL_POLL_INTERVAL_MS=5000
ORDER_PREAPPROVAL_REQUEST_TIMEOUT_MS=15000
ORDER_PREAPPROVAL_FILE_DIR=/app/uploads/order-preapproval
# ORDER_PREAPPROVAL_ETEAMS_ORIGIN=https://oa.example.com
# ORDER_PREAPPROVAL_ETEAMS_CORP_ID=__ETEAMS_CORP_ID__
# ORDER_PREAPPROVAL_ETEAMS_APP_KEY=__ETEAMS_APP_KEY__
# ORDER_PREAPPROVAL_ETEAMS_APP_SECRET=__ETEAMS_APP_SECRET__
MESSAGE_WORKER_ROLE=critical
MESSAGE_NOTIFICATION_QUEUE=v3-notification
MESSAGE_INTEGRATION_QUEUE=v3-integration
MESSAGE_MAINTENANCE_QUEUE=v3-maintenance
MESSAGE_CRITICAL_CONCURRENCY=3
MESSAGE_INTEGRATION_CONCURRENCY=3
MESSAGE_MAINTENANCE_CONCURRENCY=1
MESSAGE_CLAIM_BATCH_SIZE=100
MESSAGE_REMINDER_BATCH_SIZE=200
# 到期提醒默认提前 30 天；合并窗口仅允许 0（即时）、15 或 60 分钟。
MESSAGE_REMINDER_ADVANCE_DAYS=30
MESSAGE_REMINDER_DIGEST_MINUTES=0
MESSAGE_DEFAULT_DIGEST_MINUTES=0
MESSAGE_TASK_FAILURE_THRESHOLD=5
# 超管网页保存的企微、短信、SMTP 凭据使用此独立 32 字节 Base64 密钥加密；生产环境必须自行生成并保管，禁止提交到仓库。
# MESSAGE_CHANNEL_CONFIG_ENCRYPTION_KEY=请执行 openssl rand -base64 32 后填写
MESSAGE_WECOM_GROUP_ENABLED=false
# 企微自建应用与群机器人相互独立；应用凭据可由超管页面加密保存，禁止提交到仓库。
MESSAGE_WECOM_APP_ENABLED=false
# MESSAGE_WECOM_APP_CORP_ID=wwxxxxxxxxxxxxxxxx
# MESSAGE_WECOM_APP_AGENT_ID=1000002
# MESSAGE_WECOM_APP_SECRET=__WECOM_APP_SECRET__
MESSAGE_SMS_ENABLED=false
MESSAGE_EMAIL_ENABLED=false
# 邮箱默认关闭。以下 SMTP 凭据仅可配置在部署环境，禁止提交、写日志或进入队列载荷。
# MESSAGE_EMAIL_SMTP_HOST=smtp.example.com
# MESSAGE_EMAIL_SMTP_PORT=587
# MESSAGE_EMAIL_SMTP_SECURITY=starttls
# MESSAGE_EMAIL_SMTP_USERNAME=__SMTP_USERNAME__
# MESSAGE_EMAIL_SMTP_PASSWORD=__SMTP_PASSWORD__
# MESSAGE_EMAIL_FROM=no-reply@example.com
# MESSAGE_EMAIL_MAX_PER_MINUTE=20
# 启用消息工作进程时必须填写一次性、持久化的启用时间，例如：
# MESSAGE_EVENT_CUTOVER_AT=2026-08-14T10:00:00+08:00
# 企微群机器人地址属于凭据，只允许部署配置保管，禁止写入代码、日志和队列。
# MESSAGE_WECOM_GROUP_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=__WEBHOOK_KEY__
