APP_ENV=production
V3_MCP_ENABLED=false
V3_MCP_TRANSPORT=streamable-http
V3_MCP_HTTP_ENABLED=true
V3_MCP_BIND_HOST=0.0.0.0
V3_MCP_PORT=3307
V3_MCP_ALLOW_INTERNAL_HTTP=true
V3_MCP_EXTERNAL_TLS_REQUIRED=true
V3_MCP_API_BASE_URL=http://api-1:3100/internal/mcp
V3_MCP_SERVICE_KEY_FILE=/app/secrets/mcp_principal_private.pem
V3_MCP_ALLOWED_CLIENTS=
V3_MCP_ALLOWED_USERS=*
V3_MCP_DENIED_USERS=
V3_MCP_AUDIT_REQUIRED=true
V3_MCP_MAX_PAGE_SIZE=50
V3_MCP_QUERY_TIMEOUT_MS=3000
V3_MCP_RESPONSE_MAX_BYTES=524288
V3_MCP_RATE_LIMIT_PER_USER=60
V3_MCP_MAX_CONCURRENCY=20
V3_MCP_TOOLS_CACHE_TTL_MS=0
V3_MCP_TOOLS_CACHE_SCOPE=private
V3_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# 远程 OAuth、域名和证书就绪前保持关闭；阶段三外部入口不通过80端口开放。
V3_MCP_REAL_TOOLS_ENABLED=false
# V3_MCP_OAUTH_ISSUER=https://iam.example.com
# V3_MCP_OAUTH_RESOURCE=https://mcp.example.com/mcp
# V3_MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
# V3_MCP_OAUTH_JWKS_URL=https://iam.example.com/.well-known/jwks.json
# V3_MCP_OAUTH_SCOPES=mcp:connect
# V3_MCP_OAUTH_ALLOWED_ORIGINS=https://redclaw.example.com
V3_MCP_OAUTH_CLIENT_REGISTRATION=pre_registered
V3_MCP_OAUTH_DCR_ENABLED=false
