APP_ENV=development
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_DIR=/app/logs
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=10
LOG_COMPRESS_ROTATED=true
API_HOST=0.0.0.0
API_PORT=3100
REQUEST_BODY_LIMIT=1mb
TRUSTED_PROXY_IPS=127.0.0.1,::1
CORS_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=
DATABASE_URL=
REDIS_URL=
HEALTH_DEPENDENCY_MODE=mock
WORKER_ENABLED=true
WORKER_HEALTH_QUEUE=v3-health
V3_BUILD_VERSION=3.0.0-alpha.1
V3_BUILD_COMMIT=local
V3_BUILD_TIME=
V3_IAM_H5_SSO_ENABLED=true
V3_IAM_H5_SSO_PC_ENABLED=true
V3_IAM_H5_SSO_VALIDATE_URL=http://10.10.2.62:8192/emm-cgi/oidc/getUserFromSsoToken
V3_IAM_H5_SSO_VALIDATE_ISAID=QdCRMguanlyuan123
V3_IAM_H5_SSO_ADMIN_VALIDATE_ISAID=
V3_IAM_H5_SSO_PARTNER_VALIDATE_ISAID=
V3_IAM_H5_SSO_ADMIN_REQUEST_ISAID=QdCRMguanlyuan123
V3_IAM_H5_SSO_PARTNER_REQUEST_ISAID=QdCRMguanlyuan123
V3_IAM_H5_SSO_TIMEOUT_MS=8000
V3_UNISDP_SSO_ENABLED=true
V3_UNISDP_SSO_VALIDATE_URL=https://portal.leagsoft.com/UniSSO/auth/sso_token.json
V3_UNISDP_SSO_ISAID=QdCRMguanlyuan123
V3_UNISDP_SSO_TIMEOUT_MS=8000
# 组织架构模块（默认关闭；开启后管理端仅超级管理员可见入口，写入须另开 WRITE 开关）
V3_ORGANIZATION_ENABLED=false
V3_ORGANIZATION_WRITE_ENABLED=false
# 渠道成员手机号可能参与 IAM/UniSDP 身份匹配，专项回归前保持只读。
V3_ORGANIZATION_CHANNEL_PHONE_EDIT_ENABLED=false
# 账号状态防护与交接执行分离；开启交接前必须先开启状态防护，回退交接时不得关闭状态防护。
V3_AUTH_ACCOUNT_STATUS_CHECK_ENABLED=false
# 账号停用归档与交接执行独立开关；必须在任务进程和回归验收通过后开启。
V3_ORGANIZATION_OFFBOARDING_ENABLED=false
V3_ORGANIZATION_OFFBOARDING_POLL_INTERVAL_MS=5000
# 账号日常入口并入组织与账号；仅控制导航，默认关闭以便灰度和快速回退。
V3_ORGANIZATION_ACCOUNT_ENTRY_MERGED=false
# 企业微信组织架构同步（只读预览，默认关闭）
V3_DIRECTORY_SYNC_ENABLED=false
# 统一消息工作进程（默认关闭，生产按 DEC-0009 在完成自检后显式开启）
MESSAGE_WORKER_ENABLED=false
# 渠道产品订单预审独立任务默认关闭；启用前必须完成泛微参数、人员／区域映射和测试环境联调。
ORDER_PREAPPROVAL_WORKER_ENABLED=false
# ORDER_PREAPPROVAL_EVENT_CUTOVER_AT=2026-08-27T10:00:00+08:00
ORDER_PREAPPROVAL_POLL_INTERVAL_MS=5000
ORDER_PREAPPROVAL_REQUEST_TIMEOUT_MS=15000
ORDER_PREAPPROVAL_FILE_DIR=/app/uploads/order-preapproval
# ORDER_PREAPPROVAL_ETEAMS_ORIGIN=https://oa.example.com
# ORDER_PREAPPROVAL_ETEAMS_CORP_ID=__ETEAMS_CORP_ID__
# ORDER_PREAPPROVAL_ETEAMS_APP_KEY=__ETEAMS_APP_KEY__
# ORDER_PREAPPROVAL_ETEAMS_APP_SECRET=__ETEAMS_APP_SECRET__
